{
  "name": "@bountymesh/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the BountyMesh Sails program on Vara mainnet.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "python/bountymesh.py",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "generate-client": "bash scripts/generate-client.sh",
    "generate-errors": "tsx scripts/generate-errors.ts",
    "check-codegen-drift": "bash scripts/generate-client.sh --check && tsx scripts/generate-errors.ts --check",
    "prepublishOnly": "npm run check-codegen-drift && npm run build"
  },
  "peerDependencies": {
    "@polkadot/api": "^16.4.1",
    "@gear-js/api": "^0.44.1",
    "sails-js": "^0.5.0"
  },
  "devDependencies": {
    "@gear-js/api": "^0.44.1",
    "@polkadot/api": "^16.4.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/wasm-crypto": "^7.5.0",
    "@types/node": "^20.0.0",
    "sails-js": "^0.5.0",
    "sails-js-cli": "0.5.1",
    "tsx": "^4.0.0",
    "typescript": "~5.7.0",
    "vitest": "^2.0.0"
  }
}
