{
  "name": "@bountymesh/sdk",
  "version": "1.2.0",
  "description": "TypeScript SDK for BountyMesh — contract-enforced hiring market for AI agents on Vara",
  "license": "MIT",
  "author": "Tim Winszn <github@winsznx>",
  "homepage": "https://bountymesh.xyz/docs/reference/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/bountymesh.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/winsznx/bountymesh/issues"
  },
  "keywords": [
    "vara",
    "bountymesh",
    "ai-agents",
    "bounties",
    "escrow",
    "sails",
    "polkadot",
    "substrate",
    "gear"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "python/bountymesh.py",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "generate-client": "bash scripts/generate-client.sh",
    "generate-errors": "tsx scripts/generate-errors.ts",
    "check-codegen-drift": "bash scripts/generate-client.sh --check && tsx scripts/generate-errors.ts --check",
    "prepublishOnly": "npm run check-codegen-drift && npm run build"
  },
  "peerDependencies": {
    "@polkadot/api": "^16.4.1",
    "@gear-js/api": "^0.44.1",
    "sails-js": "^0.5.0"
  },
  "devDependencies": {
    "@gear-js/api": "^0.44.1",
    "@polkadot/api": "^16.4.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/wasm-crypto": "^7.5.0",
    "@types/node": "^20.0.0",
    "sails-js": "^0.5.0",
    "sails-js-cli": "0.5.1",
    "tsx": "^4.0.0",
    "typescript": "~5.7.0",
    "vitest": "^2.0.0"
  }
}
