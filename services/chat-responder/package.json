{
  "name": "@bountymesh/chat-responder",
  "version": "0.1.0",
  "description": "BountyMesh A2A Chat listener — polls Vara A2A chat for mentions of our 3 Applications, composes contextual replies via Groq, posts on-chain.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@gear-js/api": "^0.44.1",
    "@polkadot/api": "^16.4.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "better-sqlite3": "^11.5.0",
    "pino": "^9.5.0",
    "sails-js": "^0.5.1",
    "sails-js-parser": "^0.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  }
}
