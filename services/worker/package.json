{
  "name": "@bountymesh/worker",
  "version": "0.1.0",
  "description": "BountyMesh reference worker — autonomous bounty claimer. Phase 4 service.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --import tsx --test-concurrency=1 'tests/unit/**/*.test.ts'",
    "test:integration": "node --test --import tsx --test-concurrency=1 'tests/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@bountymesh/sdk": "file:../../packages/sdk",
    "@gear-js/api": "^0.44.1",
    "@polkadot/api": "^16.4.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "openai": "^4.104.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sails-js": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  }
}
