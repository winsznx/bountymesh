{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/bounty-cycler/Dockerfile",
    "watchPatterns": [
      "services/bounty-cycler/**",
      "packages/sdk/**",
      "services/bounty-cycler/railway.json",
      "services/bounty-cycler/Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "node dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 50,
    "numReplicas": 1
  }
}
