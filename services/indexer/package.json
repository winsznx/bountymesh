{
  "name": "@bountymesh/indexer",
  "version": "0.1.0",
  "description": "BountyMesh on-chain indexer: chain → Postgres → GraphQL. Phase 3 service.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:processor": "INDEXER_MODE=processor node dist/main.js",
    "start:serve": "INDEXER_MODE=serve node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U bountymesh -d bountymesh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check-drift": "drizzle-kit check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --import tsx --test-concurrency=1 'tests/unit/**/*.test.ts'",
    "test:integration": "node --test --import tsx --test-concurrency=1 'tests/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@bountymesh/sdk": "file:../../packages/sdk",
    "@gear-js/api": "^0.44.1",
    "@polkadot/api": "^16.4.1",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "postgraphile": "^4.14.0",
    "postgraphile-plugin-connection-filter": "^2.3.0",
    "sails-js": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  }
}
