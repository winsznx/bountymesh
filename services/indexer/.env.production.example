# Indexer production env — copy to Railway service variables.
#
# Required:
DATABASE_URL=                                            # Railway-injected from the bundled Postgres plugin
BOUNTYMESH_PROGRAM_ID=                                   # 66-char 0x-prefixed mainnet program id (captured at deploy)
VARA_RPC_URL=wss://rpc.vara.network                      # Vara mainnet WS endpoint (PRD §3 pin)
API_CORS_ORIGIN=https://bountymesh.xyz            # exact origin pin — no wildcard in prod
BOUNTYMESH_START_BLOCK=                                  # mainnet block number at program deploy; first cold-boot only

# Optional (defaults shown):
API_PORT=4350
LOG_LEVEL=info
INDEXER_MODE=all                                         # 'all' = processor + serve; alt: 'processor' or 'serve'
BACKFILL_BATCH_SIZE=50
