# Frontend production env — set in Vercel project dashboard.
#
# All four are required. NEXT_PUBLIC_ prefix exposes them to the browser bundle.
NEXT_PUBLIC_VARA_WS=wss://rpc.vara.network
NEXT_PUBLIC_INDEXER_URL=                                 # Railway public URL of the indexer service, e.g. https://api.bountymesh.xyz
NEXT_PUBLIC_BOUNTYMESH_PROGRAM_ID=                       # 66-char 0x-prefixed mainnet program id
NEXT_PUBLIC_DEMO_VERIFIED_BOUNTY_ID=                     # bountyId of a Withdrawn bounty with a verified envelope (for the landing teaser link)

# Optional override (default chainSS58 derivation reads NEXT_PUBLIC_VARA_WS):
# NEXT_PUBLIC_CHAIN_SS58_PREFIX=137                      # uncomment only if VARA_WS doesn't match the derivation heuristic
